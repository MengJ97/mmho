    <owl:Class rdf:about="http://w3id.org/mmho#Bronze">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#CopperAlloys"/>
        <rdfs:label xml:lang="en">Bronze</rdfs:label>
        <rdfs:label xml:lang="zh">青铜</rdfs:label>
    </owl:Class>
    


