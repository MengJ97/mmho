    </owl:Class>
    


    <!-- http://w3id.org/mmho#Casting_Defects -->

    <owl:Class rdf:about="http://w3id.org/mmho#Casting_Defects">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#ConditionType"/>
        <rdfs:comment xml:lang="zh">保存状态类型的子类: 铸造缺陷</rdfs:comment>
        <rdfs:label xml:lang="en">Casting Defects</rdfs:label>
        <rdfs:label xml:lang="zh">铸造缺陷</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#City -->

    <owl:Class rdf:about="http://w3id.org/mmho#City">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#AdministrativeAreaName"/>
        <rdfs:label xml:lang="en">City</rdfs:label>
        <rdfs:label xml:lang="zh">市</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ClanEmblem -->

    <owl:Class rdf:about="http://w3id.org/mmho#ClanEmblem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#Inscription"/>
        <rdfs:label xml:lang="en">Clan Emblem</rdfs:label>
        <rdfs:label xml:lang="zh">族徽</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#Condition -->

    <owl:Class rdf:about="http://w3id.org/mmho#Condition">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E3_Condition_State"/>
        <rdfs:comment xml:lang="en">Preservation condition and physical features of smelting products (especially metal artifacts), reflecting the physical changes of artifacts during burial and use. Preservation condition information is valuable for cultural heritage protection and scientific research.</rdfs:comment>
        <rdfs:comment xml:lang="zh">冶炼产品的保存状态和品相特征。</rdfs:comment>
        <rdfs:label xml:lang="en">Condition</rdfs:label>
        <rdfs:label xml:lang="zh">保存状态</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ConditionType -->

    <owl:Class rdf:about="http://w3id.org/mmho#ConditionType">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#Type"/>
        <rdfs:comment xml:lang="en">Type classification of preservation conditions, used to categorize artifact preservation states.</rdfs:comment>
        <rdfs:comment xml:lang="zh">保存状态的类型分类。</rdfs:comment>
        <rdfs:label xml:lang="en">Condition Type</rdfs:label>
        <rdfs:label xml:lang="zh">保存状态类型</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#Copper -->

    <owl:Class rdf:about="http://w3id.org/mmho#Copper">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#CopperAndCopperAlloys"/>
        <rdfs:label xml:lang="en">Copper</rdfs:label>
        <rdfs:label xml:lang="zh">纯铜</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#CopperAlloys -->

    <owl:Class rdf:about="http://w3id.org/mmho#CopperAlloys">
