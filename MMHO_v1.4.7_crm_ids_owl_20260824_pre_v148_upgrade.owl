        <rdfs:label xml:lang="en">Copper Alloys</rdfs:label>
        <rdfs:label xml:lang="zh">铜合金</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#CopperAndCopperAlloys -->

    <owl:Class rdf:about="http://w3id.org/mmho#CopperAndCopperAlloys">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#MetallicMaterials"/>
        <rdfs:label xml:lang="en">Copper And Copper Alloys</rdfs:label>
        <rdfs:label xml:lang="zh">铜与铜合金</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#CopperSmelting -->

    <owl:Class rdf:about="http://w3id.org/mmho#CopperSmelting">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#SmeltingTechniques"/>
        <rdfs:label xml:lang="en">Copper Smelting</rdfs:label>
        <rdfs:label xml:lang="zh">冶铜</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#Corrosion_State -->

    <owl:Class rdf:about="http://w3id.org/mmho#Corrosion_State">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#ConditionType"/>
        <rdfs:comment xml:lang="zh">保存状态类型的子类: 腐蚀状态</rdfs:comment>
        <rdfs:label xml:lang="en">Corrosion State</rdfs:label>
        <rdfs:label xml:lang="zh">腐蚀状态</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#County -->

    <owl:Class rdf:about="http://w3id.org/mmho#County">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#AdministrativeAreaName"/>
        <rdfs:label xml:lang="en">County</rdfs:label>
        <rdfs:label xml:lang="zh">县</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#Cupellation -->

    <owl:Class rdf:about="http://w3id.org/mmho#Cupellation">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#SmeltingTechniques"/>
        <rdfs:label xml:lang="en">Cupellation</rdfs:label>
        <rdfs:label xml:lang="zh">灰吹法</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#DimensionMeasurementUnit -->

    <owl:Class rdf:about="http://w3id.org/mmho#DimensionMeasurementUnit">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E58_Measurement_Unit"/>
        <rdfs:comment xml:lang="en">Measurement units of dimensions, such as centimeters and millimeters.</rdfs:comment>
        <rdfs:comment xml:lang="zh">尺寸的单位，如厘米、毫米等。</rdfs:comment>
        <rdfs:label xml:lang="en">Dimension Measurement Unit</rdfs:label>
        <rdfs:label xml:lang="zh">尺寸计量单位</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#DimensionType -->

    <owl:Class rdf:about="http://w3id.org/mmho#DimensionType">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#Type"/>
        <rdfs:comment xml:lang="en">Type classification of measured dimensions, such as length, width, and thickness.</rdfs:comment>
        <rdfs:comment xml:lang="zh">测量尺寸的类型分类，如长度、宽度、厚度等。</rdfs:comment>
        <rdfs:label xml:lang="en">Dimension Type</rdfs:label>
        <rdfs:label xml:lang="zh">测量尺寸类型</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#DimensionValue -->

    <owl:Class rdf:about="http://w3id.org/mmho#DimensionValue">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E60_Number"/>
        <rdfs:comment xml:lang="en">Numeric value of a dimension.</rdfs:comment>
        <rdfs:comment xml:lang="zh">尺寸的数值。</rdfs:comment>
        <rdfs:label xml:lang="en">Dimension Value</rdfs:label>
        <rdfs:label xml:lang="zh">尺寸值</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ExcavatedArtifacts -->

    <owl:Class rdf:about="http://w3id.org/mmho#ExcavatedArtifacts">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"/>
        <rdfs:comment xml:lang="en">Excavated artifacts from archaeological excavation, including production tools, smelting products, and mining materials. These artifacts are direct physical evidence for mining and metallurgy research. Inherits from CIDOC CRM E18 Physical Thing.</rdfs:comment>
        <rdfs:comment xml:lang="zh">考古发掘出土的各类遗物，包括生产工具、冶炼产品和矿冶原料。</rdfs:comment>
        <rdfs:label xml:lang="en">Excavated Artifacts</rdfs:label>
        <rdfs:label xml:lang="zh">出土遗物</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ExcavatedArtifactsType -->

    <owl:Class rdf:about="http://w3id.org/mmho#ExcavatedArtifactsType">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#Type"/>
        <rdfs:comment xml:lang="en">Type classification of excavated artifacts, used to categorize artifacts by type.</rdfs:comment>
        <rdfs:comment xml:lang="zh">出土遗物的类型分类。</rdfs:comment>
        <rdfs:label xml:lang="en">Excavated Artifacts Type</rdfs:label>
        <rdfs:label xml:lang="zh">出土遗物类型</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ExcavationInvestigationTime -->

