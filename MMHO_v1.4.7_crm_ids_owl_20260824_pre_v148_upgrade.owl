<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<rdf:RDF xmlns="http://w3id.org/mmho#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:mmho="http://w3id.org/mmho#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://w3id.org/mmho">
    <owl:Ontology rdf:about="http://w3id.org/mmho">
        <dc:creator>蒋蒙</dc:creator>
        <dc:date>2026-08-14</dc:date>
        <dc:publisher>北京科技大学科技史与文化遗产研究院</dc:publisher>
        <dc:title xml:lang="en">Mining and Metallurgy Heritage Ontology</dc:title>
        <dc:title xml:lang="zh">矿冶遗存本体</dc:title>
        <rdfs:comment xml:lang="zh">本本体用于描述先秦两汉时期矿冶遗存的相关知识，采用与CIDOC CRM v7.1.3融合的方式构建。</rdfs:comment>
        <owl:versionInfo>1.4.7</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/date -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/elements/1.1/publisher -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/publisher"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://w3id.org/mmho#belongsToAdministrativeArea -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#belongsToAdministrativeArea">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#MiningAndMetallurgySite"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#AdministrativeAreaName"/>
        <rdfs:comment xml:lang="en">Records the administrative affiliation of a mining and metallurgy site. Examples: a site belongs to Huangshi City, Hubei Province.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗址属于某个行政区域。</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to administrative area</rdfs:label>
        <rdfs:label xml:lang="zh">属于行政区域</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#belongsToPeriod -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#belongsToPeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ExcavatedArtifacts"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#MiningAndMetallurgySite"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#Period"/>
        <rdfs:comment xml:lang="en">Annotates historical period information for entities, associating archaeological cultural phases. Examples: a site belongs to late Shang Dynasty; a bronze artifact belongs to Western Zhou.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗址、遗迹单元或遗物所属的时期。</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to period</rdfs:label>
        <rdfs:label xml:lang="zh">所属时期是</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#carriedOutByInstitution -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#carriedOutByInstitution">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#InvestigativeActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ArchaeologicalInstitution"/>
        <rdfs:comment xml:lang="en">Records which archaeological institution conducted the investigative activity. Examples: an excavation conducted by the Institute of Archaeology, CASS.</rdfs:comment>
        <rdfs:comment xml:lang="zh">调查活动由哪个机构单位执行。</rdfs:comment>
        <rdfs:label xml:lang="en">carried out by institution</rdfs:label>
        <rdfs:label xml:lang="zh">由单位执行</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#classifiedAsActivityType -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#classifiedAsActivityType">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P21_had_general_purpose"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#InvestigativeActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ActivityType"/>
        <rdfs:comment xml:lang="en">Classifies investigative activities. Examples: a survey activity classified as field survey.</rdfs:comment>
        <rdfs:comment xml:lang="zh">调查活动分类（如田野调查、发掘等）</rdfs:comment>
        <rdfs:label xml:lang="en">classified as activity type</rdfs:label>
        <rdfs:label xml:lang="zh">调查活动类型为</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#classifiedAsArtifactType -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#classifiedAsArtifactType">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ExcavatedArtifacts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ExcavatedArtifactsType"/>
        <rdfs:comment xml:lang="en">Classifies excavated artifacts. Examples: this artifact type is: copper ore.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗物分类</rdfs:comment>
        <rdfs:label xml:lang="en">classified as artifact type</rdfs:label>
        <rdfs:label xml:lang="zh">遗物类型为</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#conductedAtSite -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#conductedAtSite">
        <rdfs:domain rdf:resource="http://w3id.org/mmho#InvestigativeActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#MiningAndMetallurgySite"/>
        <rdfs:comment xml:lang="en">Records which site an investigative activity was conducted at. Examples: a survey may have been conducted at a site.</rdfs:comment>
        <rdfs:comment xml:lang="zh">调查活动在哪个遗址进行。</rdfs:comment>
        <rdfs:label xml:lang="en">conducted at site</rdfs:label>
        <rdfs:label xml:lang="zh">在遗址进行活动</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#containsMaterial -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#containsMaterial">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P45_consists_of"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#MetallicMaterials"/>
        <rdfs:comment xml:lang="en">Records the mineral resources buried within a mining and metallurgy site or anthropic feature. Examples: a mining site contains copper ore.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗迹单元蕴含的金属材料类型。</rdfs:comment>
        <rdfs:label xml:lang="en">contains material</rdfs:label>
        <rdfs:label xml:lang="zh">蕴含材料是</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#excavatedFrom -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#excavatedFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ExcavatedArtifacts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:comment xml:lang="en">Records which anthropic feature a mining and metallurgy product was excavated from. Examples: a bronze artifact excavated from a tomb; a slag excavated from a smelting area.</rdfs:comment>
        <rdfs:comment xml:lang="zh">记录遗物出土于哪个遗迹单元，考古学层位原则的核心体现。</rdfs:comment>
        <rdfs:label xml:lang="en">excavated from</rdfs:label>
        <rdfs:label xml:lang="zh">出土单元是</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#foreseesUseOf -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#foreseesUseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P68_foresees_use_of"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#MetallicMaterials"/>
        <rdfs:comment xml:lang="en">Describes the materials that may be used by a production technology. Examples: iron smelting technology foresees use of iron.</rdfs:comment>
        <rdfs:comment xml:lang="zh">生产技术预知使用的材料。</rdfs:comment>
        <rdfs:label xml:lang="en">foresees use of</rdfs:label>
        <rdfs:label xml:lang="zh">预知使用</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasAssociationWith -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasAssociationWith">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P69_has_association_with"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:comment xml:lang="en">General association relation—an explicit fallback when the corpus is insufficient to determine whether a relationship is a same-period workflow chain (mmho:hasPredecessor / mmho:hasSuccessor) or a cross-period technological evolution (mmho:hasProcessEvolution).

Fallback design rationale: This is an explicit fallback to avoid hard-filling specific relations during data modeling. Modeling rule:
1. If corpus clearly indicates same-period workflow chain -&gt; use mmho:hasPredecessor / mmho:hasSuccessor
2. If corpus clearly indicates cross-period evolution -&gt; use mmho:hasProcessEvolution
3. If corpus is insufficient -&gt; use mmho:hasAssociationWith (this property)

Note: P69 (the parent property) is symmetric; mmho:hasPredecessor / mmho:hasSuccessor are inverse (directed). When specific relations and fallback associations co-exist in data, this property provides the broader "association" view.</rdfs:comment>
        <rdfs:comment xml:lang="zh">通用关联关系——用于无法精确判定为前件-后件工序关系（mmho:hasPredecessor / mmho:hasSuccessor）或跨时代工艺演化关系（mmho:hasProcessEvolution）的兜底关联。

[设计依据] 本属性是显式标注的 fallback，避免数据建模时硬填具体关系。数据建模守则：
1. 若语料能清晰判定为同期工艺链 -&gt; 填 mmho:hasPredecessor / mmho:hasSuccessor
2. 若语料能清晰判定为跨时代演化 -&gt; 填 mmho:hasProcessEvolution
3. 若语料无法判定 -&gt; 填 mmho:hasAssociationWith（本属性）

[形式区别] P69 是 symmetric 属性（关联无方向），hasPredecessor/Successor 是 inverse 对（关联有方向）。当具体属性与 fallback 关联在数据中并存时，本属性可作为更宽泛的"关联"集合使用。</rdfs:comment>
        <rdfs:label xml:lang="en">has association with</rdfs:label>
        <rdfs:label xml:lang="zh">有关联</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasBroaderTerm -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasBroaderTerm">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P127_has_broader_term"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#Type"/><rdfs:range rdf:resource="http://w3id.org/mmho#Type"/><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">Establishes hierarchical relationships among types, describing the broader term of a type. Examples: the broader term of food vessel is container.</rdfs:comment>
        <rdfs:comment xml:lang="zh">类型概念具有上位词，用于构建分类层次。</rdfs:comment>
        <rdfs:label xml:lang="en">has broader term</rdfs:label>
        <rdfs:label xml:lang="zh">拥有上位词</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasCondition -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasCondition">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P44_has_condition"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#SmeltingProducts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#Condition"/>
        <rdfs:comment xml:lang="en">Describes the preservation condition of a smelting product. Examples: a bronze artifact is in corrosion state; a bronze artifact has repair traces.</rdfs:comment>
        <rdfs:comment xml:lang="zh">冶炼产品具有的保存状态。</rdfs:comment>
        <rdfs:label xml:lang="en">has condition</rdfs:label>
        <rdfs:label xml:lang="zh">具有品相状态</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasConditionType -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasConditionType">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#Condition"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ConditionType"/>
        <rdfs:comment xml:lang="en">Classifies the preservation condition. Examples: this preservation condition type is: slight corrosion.</rdfs:comment>
        <rdfs:comment xml:lang="zh">保存状态的分类</rdfs:comment>
        <rdfs:label xml:lang="en">has condition type</rdfs:label>
        <rdfs:label xml:lang="zh">品相状态类型为</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasDimension -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasDimension">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P43_has_dimension"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ExcavatedArtifacts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ArtifactDimension"/>
        <rdfs:comment xml:lang="en">Describes the dimensions of an artifact. Examples: a bronze tripod has height, diameter, and weight dimensions.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗物具有尺寸测量值。</rdfs:comment>
        <rdfs:label xml:lang="en">has dimension</rdfs:label>
        <rdfs:label xml:lang="zh">具有尺寸</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasDimensionNumber -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasDimensionNumber">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P90_has_value"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ArtifactDimension"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#DimensionValue"/>
        <rdfs:comment xml:lang="en">Records the specific numeric value of a dimension. Examples: height: 25.5.</rdfs:comment>
        <rdfs:comment xml:lang="zh">尺寸的数值。</rdfs:comment>
        <rdfs:label xml:lang="en">has dimension number</rdfs:label>
        <rdfs:label xml:lang="zh">尺寸数值</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasDimensionType -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasDimensionType">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ArtifactDimension"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#DimensionType"/>
        <rdfs:comment xml:lang="en">Classifies the type of dimension. Examples: this dimension type is: overall height.</rdfs:comment>
        <rdfs:comment xml:lang="zh">尺寸的类型</rdfs:comment>
        <rdfs:label xml:lang="en">has dimension type</rdfs:label>
        <rdfs:label xml:lang="zh">尺寸类型为</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasDimensionUnit -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasDimensionUnit">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P91_has_unit"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ArtifactDimension"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#DimensionMeasurementUnit"/>
        <rdfs:comment xml:lang="en">Records the measurement unit of a dimension. Examples: this dimension unit is: centimeter.</rdfs:comment>
        <rdfs:comment xml:lang="zh">尺寸的单位。</rdfs:comment>
        <rdfs:label xml:lang="en">has dimension unit</rdfs:label>
        <rdfs:label xml:lang="zh">尺寸单位</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasExecutionTime -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasExecutionTime">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#InvestigativeActivity"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ExcavationInvestigationTime"/>
        <rdfs:comment xml:lang="en">Records the execution time of an investigative activity. Examples: an excavation executed from March to June 2020.</rdfs:comment>
        <rdfs:comment xml:lang="zh">调查活动的执行时间。</rdfs:comment>
        <rdfs:label xml:lang="en">has execution time</rdfs:label>
        <rdfs:label xml:lang="zh">活动执行时间为</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasFunctionalSpatialRelation -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasFunctionalSpatialRelation">
        <rdfs:domain rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:comment xml:lang="en">Annotates workflow-driven functional spatial topology between anthropogenic features within a mining and metallurgy site. Examples: between mining shaft and smelting furnace (gravity-based ore flow); between smelting area and slag heap (close-proximity slag discharge). Differs from generic proximity-based spatial relations.</rdfs:comment>
        <rdfs:comment xml:lang="zh">标注矿冶遗址内部不同人工遗迹单元之间的功能空间拓扑关系——由冶金生产流程驱动的空间组织逻辑。以铜绿山古铜矿遗址为例，采矿区的坚井与冶炼区的炼炉之间存在"矿石自高向低顺流而下"的拓扑关系；冶炼区与排渣场之间存在"废渣就近排放"的关系。这种关系与一般"邻近-距离"的地理位置关系不同，强调生产流程对空间布局的决定作用。</rdfs:comment>
        <rdfs:label xml:lang="en">has functional spatial relation</rdfs:label>
        <rdfs:label xml:lang="zh">具有功能空间关系</rdfs:label>
    </owl:ObjectProperty>
    


    


    <!-- http://w3id.org/mmho#hasMaterialComposition -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasMaterialComposition">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P3_has_note"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#MetallicMaterials"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#MaterialComponentNote"/>
        <rdfs:comment xml:lang="en">Details the composition of metallic materials. Examples: a bronze artifact composition is copper 85%, tin 12%, lead 3%.</rdfs:comment>
        <rdfs:comment xml:lang="zh">金属材料的成分描述。</rdfs:comment>
        <rdfs:label xml:lang="en">has material composition</rdfs:label>
        <rdfs:label xml:lang="zh">材料成分有</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasOriginType -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasOriginType">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P177_assigned_property_of_type"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#InferredPlaceOfOrigin"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#PlaceOfOriginType"/>
        <rdfs:comment xml:lang="en">Classifies the type of place of origin. Examples: this origin belongs to type: material origin place.</rdfs:comment>
        <rdfs:comment xml:lang="zh">原产地的分类</rdfs:comment>
        <rdfs:label xml:lang="en">has origin type</rdfs:label>
        <rdfs:label xml:lang="zh">原产地类型为</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasPeriodRelatedNotes -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasPeriodRelatedNotes">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P3_has_note"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#Period"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#PeriodRelatedNotes"/>
        <rdfs:comment xml:lang="en">Records detailed notes for time periods. Examples: late Shang Dynasty, approximately 1300-1046 BC.</rdfs:comment>
        <rdfs:comment xml:lang="zh">时期具有的相关备注信息。</rdfs:comment>
        <rdfs:label xml:lang="en">has period related notes</rdfs:label>
        <rdfs:label xml:lang="zh">有时期相关备注</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasPredecessor -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasPredecessor">
        <owl:inverseOf rdf:resource="http://w3id.org/mmho#hasSuccessor"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:comment xml:lang="en">Annotates the predecessor relation in a same-period production workflow (A must complete before B can start; A and B typically coexist in the same production chain). Examples: ore dressing precedes smelting; smelting precedes casting. Inverse of mmho:hasSuccessor.

Design rationale: This property is for same-period workflow chains only. For cross-period technological evolution, use mmho:hasProcessEvolution (a directed, non-inverse property carrying a different temporal dimension). When the corpus is insufficient to determine whether a relationship is a workflow chain or an evolution, use mmho:hasAssociationWith as an explicit fallback association.</rdfs:comment>
        <rdfs:comment xml:lang="zh">标注两个生产技术之间同期工艺链的前件工序关系（A 完成后才能开始 B；A、B 通常同期共存于同一生产流程中）。例如"选矿"是"冶炼"的前件工序，"冶炼"是"铸造"的前件工序。与 mmho:hasSuccessor 互逆。

[设计依据] 本属性仅用于同期工艺链的衔接关系；跨时代技术演化请使用 mmho:hasProcessEvolution（演化是单向、非互逆的关系，承载于不同的时间维度）。若语料不足以判定为前件-后件工序或工艺演化，请使用 mmho:hasAssociationWith 作为显式标注的兜底关联，避免硬填具体属性导致语义失真。</rdfs:comment>
        <rdfs:label xml:lang="en">has predecessor</rdfs:label>
        <rdfs:label xml:lang="zh">前件工序是</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasProcessEvolution -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasProcessEvolution">
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:comment xml:lang="en">Annotates technological evolution across different historical periods within the same technique category (A evolves to B across time; A-&gt;B != B-&gt;A). Examples: copper smelting evolved from oxide ore direct reduction to sulfide ore roasting-reduction process. The evolution is reflected in slag phase composition, furnace thermal performance, and metal product chemistry.

Design rationale: Cross-period technological evolution is a directed, non-inverse relation. This property is intentionally NOT a sub-property of crm:P69_has_association_with, because P69 is symmetric in CIDOC CRM—inheritance of symmetry would erroneously equate A-&gt;B and B-&gt;A. The property is therefore an independent top-level object property carrying directed evolution semantics.

Relation to mmho:hasPredecessor / mmho:hasSuccessor: those represent same-period workflow chains (A, B typically coexist in the same production flow); this property represents cross-period evolution (A is replaced by B across time). They are formally non-conflicting in OWL, but SPARQL queries should specify the property explicitly to avoid result ambiguity.</rdfs:comment>
        <rdfs:comment xml:lang="zh">标注同种技术在不同历史时期的工艺演化关系（A 在历史/技术发展上演化为 B；A-&gt;B != B-&gt;A）。矿冶技术的演化在炉渣物相组成、炉壁热工性能与金属产品化学成分上留下可辨识的物质印记——例如中国早期冶铜技术从氧化矿直接还原演进到硫化矿焙烧-还原冶炼的工艺跃迁。

[设计依据] 跨时代工艺演化是单向、非互逆的关系。本属性不挂父属性 mmho:P69（CIDOC CRM P69_has_association_with），原因：P69 是 symmetric（对称）属性，传递 symmetric 特性到子属性后会破坏演化的方向性（A-&gt;B 与 B-&gt;A 等价会推出错误结论）。本属性因此作为独立属性保留，以承载有向演化的语义。

[与 predecessor/successor 的关系] predecessor/successor 是同期工艺链（A、B 通常同期共存于同一生产流程）；hasProcessEvolution 是跨时代演化（A 退役后 B 取代之）。两者在 OWL 形式上不构成逻辑冲突，但 SPARQL 查询时需明确指定具体属性以避免结果混淆。</rdfs:comment>
        <rdfs:label xml:lang="en">has process evolution</rdfs:label>
        <rdfs:label xml:lang="zh">工艺演化为</rdfs:label>
    </owl:ObjectProperty>
    <!-- http://w3id.org/mmho#FunctionalSpatialRelationType -->
  <owl:Class rdf:about="http://w3id.org/mmho#FunctionalSpatialRelationType">
    <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#Type"/>
    <rdfs:comment xml:lang="zh">类型概念——本体的"功能空间关系类型"基础类。通过 mmho:Type 间接继承 CIDOC CRM crm:E55_Type。具体的功能空间关系类型（如"重力顺流型""就近排放型"等）由作者以后从考古报告语料中归纳后，作为本 Class 的实例（rdf:type）添加。本体不预设具体类型。</rdfs:comment>
    <rdfs:label xml:lang="en">functional spatial relation type</rdfs:label>
    <rdfs:label xml:lang="zh">功能空间关系类型</rdfs:label>
    <rdfs:comment xml:lang="en">Base class for the "functional spatial relation type" concept. Corresponds to CIDOC CRM crm:E55_Type through mmho:Type indirect inheritance. Concrete functional spatial relation type enumeration values are to be added later as instances (rdf:type) of this class, after being abstracted from archaeological report corpora. The ontology does not pre-instantiate concrete types.</rdfs:comment>
  </owl:Class>



  <!-- http://w3id.org/mmho#hasFunctionalSpatialRelationType -->
  <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasFunctionalSpatialRelationType">
    <rdfs:domain rdf:resource="http://w3id.org/mmho#hasFunctionalSpatialRelation"/>
    <rdfs:range rdf:resource="http://w3id.org/mmho#FunctionalSpatialRelationType"/>
    <rdfs:comment xml:lang="zh">标注功能空间关系（mmho:hasFunctionalSpatialRelation）的具体类型。配合自指属性使用——通过该修饰符属性，reasoner 与 SPARQL 可区分具体功能空间关系的性质，避免单一自指属性语义过载。

[设计依据] 本属性设计严格对应 CIDOC CRM 考古扩展 CRMarchaeo v2.1 的 AP11.1 has type 标准做法。CRMarchaeo v2.1 中 AP11.1 has type 的 Domain 是 AP11 has physical relation to（punning Domain，OWL 2 DL 允许），Range 是 crm:E55_Type。本属性复用此模式：Domain 借用 mmho:hasFunctionalSpatialRelation（punning，OWL 2 DL 允许），明确表达"该修饰符描述的是 mmho:hasFunctionalSpatialRelation 关系本身的类型"；Range 指向 mmho:FunctionalSpatialRelationType 以承载所有具体功能空间关系类型。

具体类型枚举值由作者以后从考古报告语料中归纳后，作为 mmho:FunctionalSpatialRelationType 的实例（rdf:type）添加。CRMarchaeo v2.1 给出的参考枚举值类型如"abuts on""on top of""under""runs up to""inserted by cut"等。

[数据建模规则]
1. 关系：mmho:hasFunctionalSpatialRelation 标注两个 mmho:AnthropicFeature 实例之间的功能空间关系
2. 类型标注：mmho:hasFunctionalSpatialRelationType 的 value 是 mmho:FunctionalSpatialRelationType 的实例
3. 具体类型由作者从考古报告语料中归纳后添加，本体不预设具体类型

[CRMarchaeo v2.1 参照]
  AP11.1 has type: Domain=AP11 has physical relation to, Range=crm:E55_Type
  示例：The wall C (A8) has physical relation to wall D (A8) has type abuts on (E55).</rdfs:comment>
    <rdfs:label xml:lang="en">has functional spatial relation type</rdfs:label>
    <rdfs:label xml:lang="zh">功能空间关系类型是</rdfs:label>
    <rdfs:comment xml:lang="en">Annotates the concrete type of a functional spatial relation (mmho:hasFunctionalSpatialRelation). Used together with the self-loop property—through this qualifier, reasoner and SPARQL can distinguish between concrete functional spatial relation types, avoiding semantic overloading of the single self-loop property.

[Design rationale] This property follows the CRMarchaeo v2.1 AP11.1 has type standard pattern. CRMarchaeo v2.1 defines AP11.1 has type with Domain=AP11 has physical relation to (punning Domain, OWL 2 DL allowed) and Range=crm:E55_Type. This property reuses the same pattern: Domain borrows mmho:hasFunctionalSpatialRelation (punning, OWL 2 DL allowed—standard CRMarchaeo practice); Range points to mmho:FunctionalSpatialRelationType.

Concrete enumeration values will be added later as instances (rdf:type) of mmho:FunctionalSpatialRelationType, after being abstracted from archaeological report corpora. Reference values from CRMarchaeo v2.1 include: "abuts on", "on top of", "under", "runs up to", "inserted by cut".

Data modeling rules:
1. Relation: mmho:hasFunctionalSpatialRelation annotates functional spatial relations between two mmho:AnthropicFeature instances
2. Type annotation: the value of mmho:hasFunctionalSpatialRelationType is an instance of mmho:FunctionalSpatialRelationType
3. Concrete types are added by the author after being abstracted from archaeological report corpora; the ontology does not pre-instantiate concrete types

[CRMarchaeo v2.1 reference]
  AP11.1 has type: Domain=AP11 has physical relation to, Range=crm:E55_Type
  Example: The wall C (A8) has physical relation to wall D (A8) has type abuts on (E55).</rdfs:comment>
  </owl:ObjectProperty>

  <!-- http://w3id.org/mmho#hasReferenceNumber -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasReferenceNumber">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ExcavatedArtifacts"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#MiningAndMetallurgySite"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#PrimaryReferenceNumber"/>
        <rdfs:comment xml:lang="en">Assigns unique reference numbers to sites, anthropic features, and artifacts. Examples: a site reference number HB-HS-001.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗址、遗迹单元或遗物具有的主参考编号。</rdfs:comment>
        <rdfs:label xml:lang="en">has reference number</rdfs:label>
        <rdfs:label xml:lang="zh">具有参考编号</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasSpecificYear -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasSpecificYear">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P3_has_note"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ExcavatedArtifacts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#SpecificYear"/>
        <rdfs:comment xml:lang="en">Records possible scientific dating data for artifacts. Examples: radiocarbon dating result of 3200±50 years.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗物具有的具体测年信息。</rdfs:comment>
        <rdfs:label xml:lang="en">has specific year</rdfs:label>
        <rdfs:label xml:lang="zh">有具体年代</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasSuccessor -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasSuccessor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:comment xml:lang="en">Inverse of mmho:hasPredecessor. Annotates the successor relation in a same-period production workflow—the successor process takes the output of the predecessor as its input. See mmho:hasPredecessor for full design rationale (workflow chain vs cross-period evolution vs fallback).</rdfs:comment>
        <rdfs:comment xml:lang="zh">标注两个生产技术之间同期工艺链的后件工序关系（mmho:hasPredecessor 的互逆属性）。后件工序接收前件工序的产物作为其输入。其他设计依据同 mmho:hasPredecessor：仅用于同期工艺链；跨时代演化请用 mmho:hasProcessEvolution；语义模糊时请用 mmho:hasAssociationWith 兜底。</rdfs:comment>
        <rdfs:label xml:lang="en">has successor</rdfs:label>
        <rdfs:label xml:lang="zh">后件工序是</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasVisualFeature -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasVisualFeature">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P65_shows_visual_item"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#SmeltingProducts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#VisualFeatures"/>
        <rdfs:comment xml:lang="en">Describes the visual features of a smelting product, such as patterns and inscriptions. Examples: a bronze artifact has Taotie pattern; a bronze artifact has clan emblem inscription.</rdfs:comment>
        <rdfs:comment xml:lang="zh">冶炼产品具有的视觉特征。</rdfs:comment>
        <rdfs:label xml:lang="en">has visual feature</rdfs:label>
        <rdfs:label xml:lang="zh">具有视觉特征</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#hasVisualFeatureType -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#hasVisualFeatureType">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#VisualFeatures"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#VisualFeatureType"/>
        <rdfs:comment xml:lang="en">Classifies visual features. Examples: this visual feature type is: mythological creature pattern.</rdfs:comment>
        <rdfs:comment xml:lang="zh">视觉特征的分类</rdfs:comment>
        <rdfs:label xml:lang="en">has visual feature type</rdfs:label>
        <rdfs:label xml:lang="zh">视觉特征类型为</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#identifiedByCoordinates -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#identifiedByCoordinates">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P168_place_is_defined_by"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#Location"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#GeographicCoordinates"/>
        <rdfs:comment xml:lang="en">Precisely locates a place through geographic coordinates. Examples: a site identified by X coordinate 114.9234, Y coordinate 30.1234.</rdfs:comment>
        <rdfs:comment xml:lang="zh">地点由地理坐标标识。</rdfs:comment>
        <rdfs:label xml:lang="en">identified by coordinates</rdfs:label>
        <rdfs:label xml:lang="zh">由坐标识</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#involvesTechnique -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#involvesTechnique">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ProductionTools"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#SmeltingProducts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#ProductionTechniques"/>
        <rdfs:comment xml:lang="en">Describes the production technologies involved in anthropic features, raw materials, and products. Examples: a smelting area involves block iron smelting technology; a bronze artifact involves integral casting technology.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗迹、工具或产品涉及的生产技术。</rdfs:comment>
        <rdfs:label xml:lang="en">involves technique</rdfs:label>
        <rdfs:label xml:lang="zh">涉及技术</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#isComposedOf -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#isComposedOf">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P45_consists_of"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#OreAndSmeltingMaterials"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#SmeltingProducts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#MetallicMaterials"/>
        <rdfs:comment xml:lang="en">Describes the material composition of a smelting product. Examples: a bronze artifact is composed of copper, tin, and lead.</rdfs:comment>
        <rdfs:comment xml:lang="zh">冶炼产品由何种金属材料构成。</rdfs:comment>
        <rdfs:label xml:lang="en">is composed of</rdfs:label>
        <rdfs:label xml:lang="zh">由...构成</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#isLocatedIn -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#isLocatedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#MiningAndMetallurgySite"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#Location"/>
        <rdfs:comment xml:lang="en">Records the geographic location of a mining and metallurgy site or anthropic feature. Examples: a mining site located in Huangshi City, Hubei Province; a smelting area located in the northeast of the site.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗址或遗迹单元位于某个地理位置。</rdfs:comment>
        <rdfs:label xml:lang="en">is located in</rdfs:label>
        <rdfs:label xml:lang="zh">位于</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#isPartOf -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#isPartOf">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#AnthropicFeature"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#MiningAndMetallurgySite"/>
        <rdfs:comment xml:lang="en">Records which mining and metallurgy site an anthropic feature belongs to, establishing the hierarchical relationship between features and sites. Examples: a mining pit belongs to a mining site; a smelting area belongs to a comprehensive site.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗迹单元属于某个矿冶遗址，体现遗址的组成结构。</rdfs:comment>
        <rdfs:label xml:lang="en">is part of</rdfs:label>
        <rdfs:label xml:lang="zh">属于遗址</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#wasFoundAt -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#wasFoundAt">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ExcavatedArtifacts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#Location"/>
        <rdfs:comment xml:lang="en">Records the specific location where an excavated artifact was discovered. Examples: bronze artifact found in the northeast of the site.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗物发现的具体地点。</rdfs:comment>
        <rdfs:label xml:lang="en">was found at</rdfs:label>
        <rdfs:label xml:lang="zh">出土地点是</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://w3id.org/mmho#wasProducedAt -->

    <owl:ObjectProperty rdf:about="http://w3id.org/mmho#wasProducedAt">
        <rdfs:domain rdf:resource="http://w3id.org/mmho#ExcavatedArtifacts"/>
        <rdfs:range rdf:resource="http://w3id.org/mmho#InferredPlaceOfOrigin"/>
        <rdfs:comment xml:lang="en">Records the inferred place of production for an excavated artifact, based on scientific analysis such as lead isotope analysis or trace element analysis. The inference is modelled as mmho:InferredPlaceOfOrigin (subClass of crm:E13 Attribute Assignment). No parent CRM property: crm:P53_has_former_or_current_location's Range is crm:E53 Place, while this property's Range is mmho:InferredPlaceOfOrigin (E13 Attribute Assignment)—Range types do not match.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗物的推断原产地，依据铅同位素分析或微量元素分析等科学方法推断。推断行为建模为 mmho:InferredPlaceOfOrigin（crm:E13 Attribute Assignment 的子类）。不挂父属性：crm:P53_has_former_or_current_location 的 Range 是 crm:E53 Place，本属性 Range 是 mmho:InferredPlaceOfOrigin（E13 Attribute Assignment），Range 类型不匹配。</rdfs:comment>
        <rdfs:label xml:lang="en">was produced at</rdfs:label>
        <rdfs:label xml:lang="zh">原产地是</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P127_has_broader_term -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P127_has_broader_term">
        <rdfs:label xml:lang="en">P127 has broader term</rdfs:label>
        <rdfs:label xml:lang="zh">P127 拥有上位词</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by">
        <rdfs:label xml:lang="en">P14 carried out by</rdfs:label>
        <rdfs:label xml:lang="zh">P14 执行者是</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P168_place_is_defined_by -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P168_place_is_defined_by">
        <rdfs:label xml:lang="en">P168 place is defined by</rdfs:label>
        <rdfs:label xml:lang="zh">P168 地点由其所界定</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P177_assigned_property_of_type -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P177_assigned_property_of_type">
        <rdfs:label xml:lang="en">P177 assigned property of type</rdfs:label>
        <rdfs:label xml:lang="zh">P177 分配的属性类型</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by -->

    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by">
