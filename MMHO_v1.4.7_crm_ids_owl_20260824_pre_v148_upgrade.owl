        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E42_Identifier"/>
        <rdfs:comment xml:lang="en">Primary reference number uniquely identifying sites, anthropic features, or artifacts, supporting cross-database citation and tracking.</rdfs:comment>
        <rdfs:comment xml:lang="zh">主参考编号，用于唯一标识遗址、遗迹单元或遗物。</rdfs:comment>
        <rdfs:label xml:lang="en">Primary Reference Number</rdfs:label>
        <rdfs:label xml:lang="zh">主参考编号</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ProcessingTechniques -->

    <owl:Class rdf:about="http://w3id.org/mmho#ProcessingTechniques">
