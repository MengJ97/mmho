        <rdfs:comment xml:lang="en">Various metallic materials, such as copper, iron, lead, tin, gold, and silver. These materials are the basis of mining and metallurgy products.</rdfs:comment>
        <rdfs:comment xml:lang="zh">各类金属材料，如铜、铁、铅、锡、金、银等。</rdfs:comment>
        <rdfs:label xml:lang="en">Metallic Materials</rdfs:label>
        <rdfs:label xml:lang="zh">金属材料</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#MingDynasty -->

