    <!-- http://w3id.org/mmho#hasArea -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmho#hasArea">
        <rdfs:domain rdf:resource="http://w3id.org/mmho#MiningAndMetallurgySite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Area of the mining and metallurgy site, expressed in square kilometers.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗址面积，数值记录，单位平方公里。</rdfs:comment>
        <rdfs:label xml:lang="en">has area</rdfs:label>
        <rdfs:label xml:lang="zh">具有面积</rdfs:label>
    </owl:DatatypeProperty>



    <!-- http://w3id.org/mmho#hasConservationLevel -->


    <owl:DatatypeProperty rdf:about="http://w3id.org/mmho#hasConservationLevel">
        <rdfs:domain rdf:resource="http://w3id.org/mmho#MiningAndMetallurgySite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Conservation level under the Chinese cultural heritage protection system, classified into national, provincial, municipal, and county-level.</rdfs:comment>
        <rdfs:comment xml:lang="zh">文物保护级别，按中国文物保护制度分为全国重点、省级、市级、县级四级。</rdfs:comment>
        <rdfs:label xml:lang="en">has conservation level</rdfs:label>
        <rdfs:label xml:lang="zh">具有保护级别</rdfs:label>
    </owl:DatatypeProperty>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://w3id.org/mmho#ActivityType -->

    <owl:Class rdf:about="http://w3id.org/mmho#ActivityType">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#Type"/>
        <rdfs:comment xml:lang="en">Classification of investigative activities, such as archaeological excavation and archaeological survey.</rdfs:comment>
        <rdfs:comment xml:lang="zh">调查活动的类型分类，如考古发掘、考古调查等。</rdfs:comment>
        <rdfs:label xml:lang="en">ActivityType</rdfs:label>
        <rdfs:label xml:lang="zh">活动类型</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#AdministrativeAreaName -->

    <owl:Class rdf:about="http://w3id.org/mmho#AdministrativeAreaName">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E41_Appellation"/>
        <rdfs:comment xml:lang="en">Names of administrative regions where mining and metallurgy sites are located (e.g., provinces, cities, counties), used to identify the administrative affiliation of sites. Administrative area information supports site query and management by administrative divisions.</rdfs:comment>
        <rdfs:comment xml:lang="zh">行政区域名称，如省、市、县等。</rdfs:comment>
        <rdfs:label xml:lang="en">Administrative Area Name</rdfs:label>
        <rdfs:label xml:lang="zh">行政区域名称</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#Altitude -->

    <owl:Class rdf:about="http://w3id.org/mmho#Altitude">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#GeographicCoordinates"/>
        <rdfs:label xml:lang="en">Altitude</rdfs:label>
        <rdfs:label xml:lang="zh">海拔</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#AnimalMotifPattern -->

    <owl:Class rdf:about="http://w3id.org/mmho#AnimalMotifPattern">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#Pattern"/>
        <rdfs:label xml:lang="en">Animal Motif Pattern</rdfs:label>
        <rdfs:label xml:lang="zh">现实动物纹饰</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#AnthropicFeature -->

    <owl:Class rdf:about="http://w3id.org/mmho#AnthropicFeature">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E25_Human-Made_Feature"/>
        <rdfs:comment xml:lang="en">Anthropic features intentionally created by human activities within mining and metallurgy sites, such as mining pits and shafts formed by mining activities, smelting areas formed by smelting activities, and casting areas formed by casting activities. These features are components of mining and metallurgy sites, reflecting specific mining and metallurgy production activities. Inherits from CIDOC CRM E25 Human-Made Feature. Examples: mining pits (open-pit mining pits), mining shafts (underground mining shafts), smelting areas (blocks containing furnaces and bellows pipes), casting areas (blocks containing moulds and crucibles), ash pits (waste-dumping pits).</rdfs:comment>
        <rdfs:comment xml:lang="zh">矿冶遗址内人类活动有意创建的各种遗迹单元。继承自CIDOC CRM E25 Human-Made Feature。</rdfs:comment>
        <rdfs:label xml:lang="en">Anthropic Feature</rdfs:label>
        <rdfs:label xml:lang="zh">人为遗迹单元</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ArchaeologicalInstitution -->

    <owl:Class rdf:about="http://w3id.org/mmho#ArchaeologicalInstitution">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E74_Group"/>
        <rdfs:comment xml:lang="en">Institutional units conducting archaeological investigative activities, such as the Institute of Archaeology of the Chinese Academy of Social Sciences and the Palace Museum.</rdfs:comment>
        <rdfs:comment xml:lang="zh">执行考古调查活动的机构单位，如考古研究所、博物馆等。</rdfs:comment>
        <rdfs:label xml:lang="en">Archaeological Institution</rdfs:label>
        <rdfs:label xml:lang="zh">考古单位</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ArsenicalBronze -->

    <owl:Class rdf:about="http://w3id.org/mmho#ArsenicalBronze">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#Bronze"/>
        <rdfs:label xml:lang="en">Arsenical Bronze</rdfs:label>
        <rdfs:label xml:lang="zh">砷青铜</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ArtifactDimension -->

    <owl:Class rdf:about="http://w3id.org/mmho#ArtifactDimension">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E54_Dimension"/>
        <rdfs:comment xml:lang="en">Dimension measurement values of artifacts, used to record physical size information.</rdfs:comment>
        <rdfs:comment xml:lang="zh">遗物的尺寸测量值。</rdfs:comment>
        <rdfs:label xml:lang="en">Artifact Dimension</rdfs:label>
        <rdfs:label xml:lang="zh">遗物尺寸</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#Brass -->

    <owl:Class rdf:about="http://w3id.org/mmho#Brass">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#CopperAlloys"/>
        <rdfs:label xml:lang="en">Brass</rdfs:label>
        <rdfs:label xml:lang="zh">黄铜</rdfs:label>
    </owl:Class>
    


