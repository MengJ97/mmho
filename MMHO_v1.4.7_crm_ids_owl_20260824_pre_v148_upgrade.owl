    <owl:Class rdf:about="http://w3id.org/mmho#MiningAndMetallurgySite">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E27_Site"/>
        <rdfs:comment xml:lang="en">Sites primarily engaged in mining, smelting, casting, and other metallurgical activities, preserving the material remains of human exploitation and utilization of mineral resources at specific locations. These sites may contain multiple anthropic features, including mining pits, mining shafts, smelting areas, and casting areas. Inherits from CIDOC CRM E27 Site. Examples: Tonglushan Ancient Copper Mine Site, Yinxu Miaopu Beidi Bronze Casting Site, Luoyang Beiyao Western Zhou Bronze Casting Site.</rdfs:comment>
        <rdfs:comment xml:lang="zh">以采矿、冶炼、铸造等矿冶活动为主的遗址。继承自CIDOC CRM E27 Site。</rdfs:comment>
        <rdfs:label xml:lang="en">Mining and Metallurgy Site</rdfs:label>
        <rdfs:label xml:lang="zh">矿冶遗址</rdfs:label>
    </owl:Class>
    


