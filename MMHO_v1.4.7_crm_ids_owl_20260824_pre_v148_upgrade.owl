        <rdfs:comment xml:lang="zh">原产地推断的类型分类。</rdfs:comment>
        <rdfs:label xml:lang="en">Place of Origin Type</rdfs:label>
        <rdfs:label xml:lang="zh">原产地类型</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#PrimaryReferenceNumber -->

