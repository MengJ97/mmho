        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#ProductionTools"/>
        <rdfs:label xml:lang="en">Processing Tools</rdfs:label>
        <rdfs:label xml:lang="zh">加工工具</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ProductionTechniques -->

    <owl:Class rdf:about="http://w3id.org/mmho#ProductionTechniques">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure"/>
        <rdfs:comment xml:lang="en">Various technical methods adopted in the mining and metallurgy production process, including mining, smelting, casting, and processing techniques.</rdfs:comment>
        <rdfs:comment xml:lang="zh">矿冶生产过程中采用的各类技术方法。</rdfs:comment>
        <rdfs:label xml:lang="en">Production Techniques</rdfs:label>
        <rdfs:label xml:lang="zh">生产技术</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#ProductionTools -->

    <owl:Class rdf:about="http://w3id.org/mmho#ProductionTools">
        <rdfs:subClassOf rdf:resource="http://w3id.org/mmho#ExcavatedArtifactsType"/>
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E22_Man-Made_Object"/>
        <rdfs:comment xml:lang="en">Production tools used in mining and metallurgy activities, including mining tools, smelting tools, casting tools, and processing tools. These tools reflect the technological level of mining and metallurgy at the time. Examples: stone hammers, crucibles, smelting furnaces, moulds.</rdfs:comment>
        <rdfs:comment xml:lang="zh">矿冶生产过程中使用的各类工具，如采矿工具、冶炼工具等。</rdfs:comment>
        <rdfs:label xml:lang="en">Production Tools</rdfs:label>
        <rdfs:label xml:lang="zh">生产工具</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#Province -->

    <owl:Class rdf:about="http://w3id.org/mmho#Province">
