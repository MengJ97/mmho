        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E41_Appellation"/>
        <rdfs:comment xml:lang="en">Archaeological cultural periodization, mapped to CIDOC CRM E41 Appellation to facilitate the use of typological features. Examples: Shang Dynasty, Western Zhou, Han Dynasty.</rdfs:comment>
        <rdfs:comment xml:lang="zh">考古学文化分期，映射为E41 Appellation以兼容类型化特征。</rdfs:comment>
        <rdfs:label xml:lang="en">Period</rdfs:label>
        <rdfs:label xml:lang="zh">时代</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/mmho#PeriodRelatedNotes -->

    <owl:Class rdf:about="http://w3id.org/mmho#PeriodRelatedNotes">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E62_String"/>
        <rdfs:comment xml:lang="en">Notes related to a time period, used to record detailed explanations of the period.</rdfs:comment>
        <rdfs:comment xml:lang="zh">与时期相关的备注信息。</rdfs:comment>
        <rdfs:label xml:lang="en">Period Related Notes</rdfs:label>
        <rdfs:label xml:lang="zh">时期相关备注</rdfs:label>
    </owl:Class>
    


