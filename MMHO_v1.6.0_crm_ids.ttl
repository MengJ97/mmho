:belongsToAdministrativeArea a owl:ObjectProperty ;
    rdfs:label "belongs to administrative area"@en,
        "属于行政区域"@zh ;
    rdfs:comment "Records the administrative affiliation of a mining and metallurgy site. Examples: a site belongs to Huangshi City, Hubei Province."@en,
        "遗址属于某个行政区域。"@zh ;
    rdfs:domain :MiningAndMetallurgySite ;
    rdfs:range :AdministrativeAreaName ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by> .

:belongsToPeriod a owl:ObjectProperty ;
    rdfs:label "belongs to period"@en,
        "所属时期是"@zh ;
    rdfs:comment "Annotates historical period information for entities, associating archaeological cultural phases. Examples: a site belongs to late Shang Dynasty; a bronze artifact belongs to Western Zhou."@en,
        "遗址、遗迹单元或遗物所属的时期。"@zh ;
    rdfs:domain :AnthropicFeature,
        :ExcavatedArtifacts,
        :MiningAndMetallurgySite ;
    rdfs:range :Period ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by> .

:carriedOutByInstitution a owl:ObjectProperty ;
    rdfs:label "carried out by institution"@en,
        "由单位执行"@zh ;
    rdfs:comment "Records which archaeological institution conducted the investigative activity. Examples: an excavation conducted by the Institute of Archaeology, CASS."@en,
        "调查活动由哪个机构单位执行。"@zh ;
    rdfs:domain :InvestigativeActivity ;
    rdfs:range :ArchaeologicalInstitution ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by> .

:classifiedAsActivityType a owl:ObjectProperty ;
    rdfs:label "classified as activity type"@en,
        "调查活动类型为"@zh ;
    rdfs:comment "Classifies investigative activities. Examples: a survey activity classified as field survey."@en,
        "调查活动分类（如田野调查、发掘等）"@zh ;
    rdfs:domain :InvestigativeActivity ;
    rdfs:range :ActivityType ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P21_had_general_purpose> .

:classifiedAsArtifactType a owl:ObjectProperty ;
    rdfs:label "classified as artifact type"@en,
        "遗物类型为"@zh ;
    rdfs:comment "Classifies excavated artifacts. Examples: this artifact type is: copper ore."@en,
        "遗物分类"@zh ;
    rdfs:domain :ExcavatedArtifacts ;
    rdfs:range :ExcavatedArtifactsType ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> .

:conductedAtSite a owl:ObjectProperty ;
    rdfs:label "conducted at site"@en,
        "在遗址进行活动"@zh ;
    rdfs:comment "Records which site an investigative activity was conducted at. Examples: a survey may have been conducted at a site."@en,
        "调查活动在哪个遗址进行。"@zh ;
    rdfs:domain :InvestigativeActivity ;
    rdfs:range :MiningAndMetallurgySite .

:consistsOfComponent a owl:ObjectProperty ;
    rdfs:label "consists of component"@en,
        "包含组件"@zh ;
    rdfs:comment "器物组合件所包含的组件器物，建立组合件与单件器物之间的包含关系（Domain=mmho:ArtifactAssemblage, Range=mmho:FinalProducts, subPropertyOf crm:P46i_forms_part_of）。用于 ABox 数据填充时连接具体组合件实例与其组件。"@zh ;
    rdfs:domain :ArtifactAssemblage ;
    rdfs:range :FinalProducts ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> .

:containsMaterial a owl:ObjectProperty ;
    rdfs:label "contains material"@en,
        "蕴含材料是"@zh ;
    rdfs:comment "Records the mineral resources buried within a mining and metallurgy site or anthropic feature. Examples: a mining site contains copper ore."@en,
        "遗迹单元蕴含的金属材料类型。"@zh ;
    rdfs:domain :AnthropicFeature ;
    rdfs:range :MetallicMaterials ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P45_consists_of> .

:excavatedFrom a owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "excavated from"@en,
        "出土单元是"@zh ;
    rdfs:comment "Records which anthropic feature a mining and metallurgy product was excavated from. Examples: a bronze artifact excavated from a tomb; a slag excavated from a smelting area."@en,
        "记录遗物出土于哪个遗迹单元，考古学层位原则的核心体现。"@zh ;
    rdfs:domain :ExcavatedArtifacts ;
    rdfs:range :AnthropicFeature .

:foreseesUseOf a owl:ObjectProperty ;
    rdfs:label "foresees use of"@en,
        "预知使用"@zh ;
    rdfs:comment "Describes the materials that may be used by a production technology. Examples: iron smelting technology foresees use of iron."@en,
        "生产技术预知使用的材料。"@zh ;
    rdfs:domain :ProductionTechniques ;
    rdfs:range :MetallicMaterials ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P68_foresees_use_of> .

:hasArea a owl:ObjectProperty ;
    rdfs:label "has area"@en,
        "具有面积"@zh ;
    rdfs:comment "Area of the mining and metallurgy site, expressed as a string with unit (defaulting to square kilometers)."@en,
        "遗址面积，字符串记录，包含数值和单位（默认为平方公里）。"@zh ;
    rdfs:domain :MiningAndMetallurgySite ;
    rdfs:range :Area .

:hasAssociationWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has association with"@en,
        "有关联"@zh ;
    rdfs:comment """General association relation—an explicit fallback when the corpus is insufficient to determine whether a relationship is a same-period workflow chain (mmho:hasPredecessor / mmho:hasSuccessor) or a cross-period technological evolution (mmho:hasProcessEvolution).

Fallback design rationale: This is an explicit fallback to avoid hard-filling specific relations during data modeling. Modeling rule:
1. If corpus clearly indicates same-period workflow chain -> use mmho:hasPredecessor / mmho:hasSuccessor
2. If corpus clearly indicates cross-period evolution -> use mmho:hasProcessEvolution
3. If corpus is insufficient -> use mmho:hasAssociationWith (this property)

Note: P69 (the parent property) is symmetric; mmho:hasPredecessor / mmho:hasSuccessor are inverse (directed). When specific relations and fallback associations co-exist in data, this property provides the broader "association" view."""@en,
        """通用关联关系——用于无法精确判定为前件-后件工序关系（mmho:hasPredecessor / mmho:hasSuccessor）或跨时代工艺演化关系（mmho:hasProcessEvolution）的兜底关联。

[设计依据] 本属性是显式标注的 fallback，避免数据建模时硬填具体关系。数据建模守则：
1. 若语料能清晰判定为同期工艺链 -> 填 mmho:hasPredecessor / mmho:hasSuccessor
2. 若语料能清晰判定为跨时代演化 -> 填 mmho:hasProcessEvolution
3. 若语料无法判定 -> 填 mmho:hasAssociationWith（本属性）

[形式区别] P69 是 symmetric 属性（关联无方向），hasPredecessor/Successor 是 inverse 对（关联有方向）。当具体属性与 fallback 关联在数据中并存时，本属性可作为更宽泛的"关联"集合使用。"""@zh ;
    rdfs:domain :ProductionTechniques ;
    rdfs:range :ProductionTechniques ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P69_has_association_with> .

:hasBroaderPeriod a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has broader period"@en,
        "拥有上位时期"@zh ;
    rdfs:comment "时序概念的上位时期，用于构建朝代分类层次（Domain=Range=mmho:Period 自指，Transitive 传递）。与 mmho:hasBroaderTerm 区分：后者用于 mmho:Type 子类层级（Domain=Range=mmho:Type），本属性专用于 mmho:Period 层级。"@zh ;
    rdfs:domain :Period ;
    rdfs:range :Period .

:hasBroaderTerm a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has broader term"@en,
        "拥有上位词"@zh ;
    rdfs:comment "Establishes hierarchical relationships among types, describing the broader term of a type. Examples: the broader term of food vessel is container."@en,
        "类型概念具有上位词，用于构建分类层次。"@zh ;
    rdfs:domain :Type ;
    rdfs:range :Type ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P127_has_broader_term> .

:hasCondition a owl:ObjectProperty ;
    rdfs:label "has condition"@en,
        "具有品相状态"@zh ;
    rdfs:comment "Describes the preservation condition of a smelting product. Examples: a bronze artifact is in corrosion state; a bronze artifact has repair traces."@en,
        "物理事物（遗物或冶炼产品）具有的保存状态，如腐蚀、修复痕迹等。v1.5.0 起 Domain 从 SmeltingProducts 扩展为 E18_Physical_Thing。"@zh ;
    rdfs:domain :ExcavatedArtifacts ;
    rdfs:range :Condition ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P44_has_condition> .

:hasConditionType a owl:ObjectProperty ;
    rdfs:label "has condition type"@en,
        "品相状态类型为"@zh ;
    rdfs:comment "Classifies the preservation condition. Examples: this preservation condition type is: slight corrosion."@en,
        "保存状态的分类"@zh ;
    rdfs:domain :Condition ;
    rdfs:range :ConditionType ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> .

:hasConservationLevel a owl:ObjectProperty ;
    rdfs:label "has conservation level"@en,
        "具有保护级别"@zh ;
    rdfs:comment "Conservation level under the Chinese cultural heritage protection system, classified into national, provincial, municipal, and county-level."@en,
        "文物保护级别，按中国文物保护制度分为全国重点、省级、市级、县级四级。"@zh ;
    rdfs:domain :MiningAndMetallurgySite ;
    rdfs:range :ConservationLevel ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> .

:hasDimension a owl:ObjectProperty ;
    rdfs:label "has dimension"@en,
        "具有尺寸"@zh ;
    rdfs:comment "Describes the dimensions of an artifact or an anthropic feature. Examples: a bronze tripod has height, diameter, and weight dimensions; a mining shaft has depth and cross-section dimensions."@en,
        "遗物或遗迹具有尺寸测量值。"@zh ;
    rdfs:domain :AnthropicFeature,
        :ExcavatedArtifacts ;
    rdfs:range :DimensionInformation ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P43_has_dimension> .

:hasDimensionNumber a owl:ObjectProperty ;
    rdfs:label "has dimension number"@en,
        "尺寸数值"@zh ;
    rdfs:comment "Records the specific numeric value of a dimension. Examples: height: 25.5."@en,
        "尺寸的数值。"@zh ;
    rdfs:domain :Area,
        :DimensionInformation ;
    rdfs:range :DimensionValue ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P90_has_value> .

:hasDimensionType a owl:ObjectProperty ;
    rdfs:label "has dimension type"@en,
        "尺寸类型为"@zh ;
    rdfs:comment "Classifies the type of dimension. Examples: this dimension type is: overall height."@en,
        "尺寸的类型"@zh ;
    rdfs:domain :DimensionInformation ;
    rdfs:range :DimensionType ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> .

:hasDimensionUnit a owl:ObjectProperty ;
    rdfs:label "has dimension unit"@en,
        "尺寸单位"@zh ;
    rdfs:comment "Records the measurement unit of a dimension. Examples: this dimension unit is: centimeter."@en,
        "尺寸的单位。"@zh ;
    rdfs:domain :Area,
        :DimensionInformation ;
    rdfs:range :DimensionMeasurementUnit ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P91_has_unit> .

:hasExecutionTime a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has execution time"@en,
        "活动执行时间为"@zh ;
    rdfs:comment "Records the execution time of an investigative activity. Examples: an excavation executed from March to June 2020."@en,
        "调查活动的执行时间。"@zh ;
    rdfs:domain :InvestigativeActivity ;
    rdfs:range :ExcavationInvestigationTime ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span> .

:hasFunctionalSpatialRelationType a owl:ObjectProperty ;
    rdfs:label "has functional spatial relation type"@en,
        "功能空间关系类型是"@zh ;
    rdfs:comment """Annotates the concrete type of a functional spatial relation (mmho:hasFunctionalSpatialRelation). Used together with the self-loop property—through this qualifier, reasoner and SPARQL can distinguish between concrete functional spatial relation types, avoiding semantic overloading of the single self-loop property.

[Design rationale] This property follows the CRMarchaeo v2.1 AP11.1 has type standard pattern. CRMarchaeo v2.1 defines AP11.1 has type with Domain=AP11 has physical relation to (punning Domain, OWL 2 DL allowed) and Range=crm:E55_Type. This property reuses the same pattern: Domain borrows mmho:hasFunctionalSpatialRelation (punning, OWL 2 DL allowed—standard CRMarchaeo practice); Range points to mmho:FunctionalSpatialRelationType.

Concrete enumeration values will be added later as instances (rdf:type) of mmho:FunctionalSpatialRelationType, after being abstracted from archaeological report corpora. Reference values from CRMarchaeo v2.1 include: "abuts on", "on top of", "under", "runs up to", "inserted by cut".

Data modeling rules:
1. Relation: mmho:hasFunctionalSpatialRelation annotates functional spatial relations between two mmho:AnthropicFeature instances
2. Type annotation: the value of mmho:hasFunctionalSpatialRelationType is an instance of mmho:FunctionalSpatialRelationType
3. Concrete types are added by the author after being abstracted from archaeological report corpora; the ontology does not pre-instantiate concrete types

[CRMarchaeo v2.1 reference]
  AP11.1 has type: Domain=AP11 has physical relation to, Range=crm:E55_Type
  Example: The wall C (A8) has physical relation to wall D (A8) has type abuts on (E55)."""@en,
        """标注功能空间关系（mmho:hasFunctionalSpatialRelation）的具体类型。配合自指属性使用——通过该修饰符属性，reasoner 与 SPARQL 可区分具体功能空间关系的性质，避免单一自指属性语义过载。

[设计依据] 本属性设计严格对应 CIDOC CRM 考古扩展 CRMarchaeo v2.1 的 AP11.1 has type 标准做法。CRMarchaeo v2.1 中 AP11.1 has type 的 Domain 是 AP11 has physical relation to（punning Domain，OWL 2 DL 允许），Range 是 crm:E55_Type。本属性复用此模式：Domain 借用 mmho:hasFunctionalSpatialRelation（punning，OWL 2 DL 允许），明确表达"该修饰符描述的是 mmho:hasFunctionalSpatialRelation 关系本身的类型"；Range 指向 mmho:FunctionalSpatialRelationType 以承载所有具体功能空间关系类型。

具体类型枚举值由作者以后从考古报告语料中归纳后，作为 mmho:FunctionalSpatialRelationType 的实例（rdf:type）添加。CRMarchaeo v2.1 给出的参考枚举值类型如"abuts on""on top of""under""runs up to""inserted by cut"等。

[数据建模规则]
1. 关系：mmho:hasFunctionalSpatialRelation 标注两个 mmho:AnthropicFeature 实例之间的功能空间关系
2. 类型标注：mmho:hasFunctionalSpatialRelationType 的 value 是 mmho:FunctionalSpatialRelationType 的实例
3. 具体类型由作者从考古报告语料中归纳后添加，本体不预设具体类型

[CRMarchaeo v2.1 参照]
  AP11.1 has type: Domain=AP11 has physical relation to, Range=crm:E55_Type
  示例：The wall C (A8) has physical relation to wall D (A8) has type abuts on (E55)."""@zh ;
    rdfs:domain :hasFunctionalSpatialRelation ;
    rdfs:range :FunctionalSpatialRelationType .

:hasMaterialComposition a owl:ObjectProperty ;
    rdfs:label "has material composition"@en,
        "材料成分有"@zh ;
    rdfs:comment "Details the composition of metallic materials. Examples: a bronze artifact composition is copper 85%, tin 12%, lead 3%."@en,
        "金属材料的成分描述。"@zh ;
    rdfs:domain :MetallicMaterials ;
    rdfs:range :MaterialComponentNote ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P3_has_note> .

:hasOriginType a owl:ObjectProperty ;
    rdfs:label "has origin type"@en,
        "原产地类型为"@zh ;
    rdfs:comment "Classifies the type of place of origin. Examples: this origin belongs to type: material origin place."@en,
        "原产地的分类"@zh ;
    rdfs:domain :InferredPlaceOfOrigin ;
    rdfs:range :PlaceOfOriginType ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P177_assigned_property_of_type> .

:hasPeriodRelatedNotes a owl:ObjectProperty ;
    rdfs:label "has period related notes"@en,
        "有时期相关备注"@zh ;
    rdfs:comment "Records detailed notes for time periods. Examples: late Shang Dynasty, approximately 1300-1046 BC."@en,
        "时期具有的相关备注信息。"@zh ;
    rdfs:domain :Period ;
    rdfs:range :PeriodRelatedNotes ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P3_has_note> .

:hasPredecessor a owl:ObjectProperty ;
    rdfs:label "has predecessor"@en,
        "前件工序是"@zh ;
    rdfs:comment """Annotates the predecessor relation in a same-period production workflow (A must complete before B can start; A and B typically coexist in the same production chain). Examples: ore dressing precedes smelting; smelting precedes casting. Inverse of mmho:hasSuccessor.

Design rationale: This property is for same-period workflow chains only. For cross-period technological evolution, use mmho:hasProcessEvolution (a directed, non-inverse property carrying a different temporal dimension). When the corpus is insufficient to determine whether a relationship is a workflow chain or an evolution, use mmho:hasAssociationWith as an explicit fallback association."""@en,
        """标注两个生产技术之间同期工艺链的前件工序关系（A 完成后才能开始 B；A、B 通常同期共存于同一生产流程中）。例如"选矿"是"冶炼"的前件工序，"冶炼"是"铸造"的前件工序。与 mmho:hasSuccessor 互逆。

[设计依据] 本属性仅用于同期工艺链的衔接关系；跨时代技术演化请使用 mmho:hasProcessEvolution（演化是单向、非互逆的关系，承载于不同的时间维度）。若语料不足以判定为前件-后件工序或工艺演化，请使用 mmho:hasAssociationWith 作为显式标注的兜底关联，避免硬填具体属性导致语义失真。"""@zh ;
    rdfs:domain :ProductionTechniques ;
    rdfs:range :ProductionTechniques ;
    owl:inverseOf :hasSuccessor .

:hasProcessEvolution a owl:ObjectProperty ;
    rdfs:label "has process evolution"@en,
        "工艺演化为"@zh ;
    rdfs:comment """Annotates technological evolution across different historical periods within the same technique category (A evolves to B across time; A->B != B->A). Examples: copper smelting evolved from oxide ore direct reduction to sulfide ore roasting-reduction process. The evolution is reflected in slag phase composition, furnace thermal performance, and metal product chemistry.

Design rationale: Cross-period technological evolution is a directed, non-inverse relation. This property is intentionally NOT a sub-property of crm:P69_has_association_with, because P69 is symmetric in CIDOC CRM—inheritance of symmetry would erroneously equate A->B and B->A. The property is therefore an independent top-level object property carrying directed evolution semantics.

Relation to mmho:hasPredecessor / mmho:hasSuccessor: those represent same-period workflow chains (A, B typically coexist in the same production flow); this property represents cross-period evolution (A is replaced by B across time). They are formally non-conflicting in OWL, but SPARQL queries should specify the property explicitly to avoid result ambiguity."""@en,
        """标注同种技术在不同历史时期的工艺演化关系（A 在历史/技术发展上演化为 B；A->B != B->A）。矿冶技术的演化在炉渣物相组成、炉壁热工性能与金属产品化学成分上留下可辨识的物质印记——例如中国早期冶铜技术从氧化矿直接还原演进到硫化矿焙烧-还原冶炼的工艺跃迁。

[设计依据] 跨时代工艺演化是单向、非互逆的关系。本属性不挂父属性 mmho:P69（CIDOC CRM P69_has_association_with），原因：P69 是 symmetric（对称）属性，传递 symmetric 特性到子属性后会破坏演化的方向性（A->B 与 B->A 等价会推出错误结论）。本属性因此作为独立属性保留，以承载有向演化的语义。

[与 predecessor/successor 的关系] predecessor/successor 是同期工艺链（A、B 通常同期共存于同一生产流程）；hasProcessEvolution 是跨时代演化（A 退役后 B 取代之）。两者在 OWL 形式上不构成逻辑冲突，但 SPARQL 查询时需明确指定具体属性以避免结果混淆。"""@zh ;
    rdfs:domain :ProductionTechniques ;
    rdfs:range :ProductionTechniques .

:hasReferenceNumber a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has reference number"@en,
        "具有参考编号"@zh ;
    rdfs:comment "Assigns unique reference numbers to sites, anthropic features, and artifacts. Examples: a site reference number HB-HS-001."@en,
        "遗址、遗迹单元或遗物具有的主参考编号。"@zh ;
    rdfs:domain :AnthropicFeature,
        :ExcavatedArtifacts,
        :MiningAndMetallurgySite ;
    rdfs:range :PrimaryReferenceNumber ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by> .

:hasSpecificYear a owl:ObjectProperty ;
    rdfs:label "has specific year"@en,
        "有具体年代"@zh ;
    rdfs:comment "Records possible scientific dating data for artifacts. Examples: radiocarbon dating result of 3200±50 years."@en,
        "遗物具有的具体测年信息。"@zh ;
    rdfs:domain :ExcavatedArtifacts ;
    rdfs:range :SpecificYear ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P3_has_note> .

:hasVisualFeature a owl:ObjectProperty ;
    rdfs:label "has visual feature"@en,
        "具有视觉特征"@zh ;
    rdfs:comment "Describes the visual features of a smelting product, such as patterns and inscriptions. Examples: a bronze artifact has Taotie pattern; a bronze artifact has clan emblem inscription."@en,
        "物理事物（遗物或冶炼产品）具有的视觉特征，如纹饰、铭文等。v1.5.0 起 Domain 从 SmeltingProducts 扩展为 E18_Physical_Thing。"@zh ;
    rdfs:domain :ExcavatedArtifacts ;
    rdfs:range :VisualFeatures ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P65_shows_visual_item> .

:hasVisualFeatureType a owl:ObjectProperty ;
    rdfs:label "has visual feature type"@en,
        "视觉特征类型为"@zh ;
    rdfs:comment "Classifies visual features. Examples: this visual feature type is: mythological creature pattern."@en,
        "视觉特征的分类"@zh ;
    rdfs:domain :VisualFeatures ;
    rdfs:range :VisualFeatureType ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> .

:identifiedByCoordinates a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "identified by coordinates"@en,
        "由坐标识"@zh ;
    rdfs:comment "Precisely locates a place through geographic coordinates. Examples: a site identified by X coordinate 114.9234, Y coordinate 30.1234."@en,
        "地点由地理坐标标识。"@zh ;
    rdfs:domain :Location ;
    rdfs:range :GeographicCoordinates ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P168_place_is_defined_by> .

:involvesTechnique a owl:ObjectProperty ;
    rdfs:label "involves technique"@en,
        "涉及技术"@zh ;
    rdfs:comment "Describes the production technologies involved in anthropic features, raw materials, and products. Examples: a smelting area involves block iron smelting technology; a bronze artifact involves integral casting technology."@en,
        "遗迹、工具或产品涉及的生产技术。"@zh ;
    rdfs:domain :AnthropicFeature,
        :ProductionTools,
        :SmeltingProducts ;
    rdfs:range :ProductionTechniques ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P67i_is_referred_to_by> .

:isComposedOf a owl:ObjectProperty ;
    rdfs:label "is composed of"@en,
        "由...构成"@zh ;
    rdfs:comment "Describes the material composition of a smelting product. Examples: a bronze artifact is composed of copper, tin, and lead."@en,
        "冶炼产品由何种金属材料构成。"@zh ;
    rdfs:domain :OreAndSmeltingMaterials,
        :SmeltingProducts ;
    rdfs:range :MetallicMaterials ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P45_consists_of> .

:isLocatedIn a owl:ObjectProperty ;
    rdfs:label "is located in"@en,
        "位于"@zh ;
    rdfs:comment "Records the geographic location of a mining and metallurgy site or anthropic feature. Examples: a mining site located in Huangshi City, Hubei Province; a smelting area located in the northeast of the site."@en,
        "遗址或遗迹单元位于某个地理位置。"@zh ;
    rdfs:domain :AnthropicFeature,
        :MiningAndMetallurgySite ;
    rdfs:range :Location ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location> .

:isPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is part of"@en,
        "属于遗址"@zh ;
    rdfs:comment "Records which mining and metallurgy site an anthropic feature belongs to, establishing the hierarchical relationship between features and sites. Examples: a mining pit belongs to a mining site; a smelting area belongs to a comprehensive site."@en,
        "遗迹单元属于某个矿冶遗址，体现遗址的组成结构。"@zh ;
    rdfs:domain :AnthropicFeature ;
    rdfs:range :MiningAndMetallurgySite ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of> .

:wasFoundAt a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "was found at"@en,
        "出土地点是"@zh ;
    rdfs:comment "Records the specific location where an excavated artifact was discovered. Examples: bronze artifact found in the northeast of the site."@en,
        "遗物发现的具体地点。"@zh ;
    rdfs:domain :ExcavatedArtifacts ;
    rdfs:range :Location ;
    rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P53_has_former_or_current_location> .

:wasProducedAt a owl:ObjectProperty ;
    rdfs:label "was produced at"@en,
        "原产地是"@zh ;
    rdfs:comment "Records the inferred place of production for an excavated artifact, based on scientific analysis such as lead isotope analysis or trace element analysis. The inference is modelled as mmho:InferredPlaceOfOrigin (subClass of crm:E13 Attribute Assignment). No parent CRM property: crm:P53_has_former_or_current_location's Range is crm:E53 Place, while this property's Range is mmho:InferredPlaceOfOrigin (E13 Attribute Assignment)—Range types do not match."@en,
        "遗物的推断原产地，依据铅同位素分析或微量元素分析等科学方法推断。推断行为建模为 mmho:InferredPlaceOfOrigin（crm:E13 Attribute Assignment 的子类）。不挂父属性：crm:P53_has_former_or_current_location 的 Range 是 crm:E53 Place，本属性 Range 是 mmho:InferredPlaceOfOrigin（E13 Attribute Assignment），Range 类型不匹配。"@zh ;
    rdfs:domain :ExcavatedArtifacts ;
    rdfs:range :InferredPlaceOfOrigin .

owl:Thing a owl:Class .

:Altitude a owl:Class ;
    rdfs:label "Altitude"@en,
        "海拔"@zh ;
    rdfs:subClassOf :GeographicCoordinates .

:ArchaeologicalInstitution a owl:Class ;
    rdfs:label "Archaeological Institution"@en,
        "考古单位"@zh ;
    rdfs:comment "Institutional units conducting archaeological investigative activities, such as the Institute of Archaeology of the Chinese Academy of Social Sciences and the Palace Museum."@en,
        "执行考古调查活动的机构单位，如考古研究所、博物馆等。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E74_Group> .

:ArtifactAssemblage a owl:Class ;
    rdfs:label "Artifact Assemblage"@en,
        "器物组合件"@zh ;
    rdfs:comment "考古出土场景中由多个独立器物组合而成的器物群。典型实例如编钟、车马器组合、酒器组合等。本类用于建模器物组合件这一**类型概念**（TBox），具体某一组（如\"曾侯乙编钟组合\"）应在 ABox 数据填充时作为本类的实例（NamedIndividual）建模，并通过 mmho:consistsOfComponent 属性关联其组件。"@zh ;
    rdfs:subClassOf :FinalProducts .

:Brass a owl:Class ;
    rdfs:label "Brass"@en,
        "黄铜"@zh ;
    rdfs:subClassOf :CopperAlloys .

:Cupellation a owl:Class ;
    rdfs:label "Cupellation"@en,
        "灰吹法"@zh ;
    rdfs:subClassOf :SmeltingTechniques .

:DimensionMeasurementUnit a owl:Class ;
    rdfs:label "Dimension Measurement Unit"@en,
        "尺寸计量单位"@zh ;
    rdfs:comment "Measurement units of dimensions, such as centimeters and millimeters."@en,
        "尺寸的单位，如厘米、毫米等。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E58_Measurement_Unit> .

:DimensionValue a owl:Class ;
    rdfs:label "Dimension Value"@en,
        "尺寸值"@zh ;
    rdfs:comment "Numeric value of a dimension."@en,
        "尺寸的数值。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E60_Number> .

:ExcavationInvestigationTime a owl:Class ;
    rdfs:label "Excavation Investigation Time"@en,
        "发掘调查时间"@zh ;
    rdfs:comment "Time span of excavation and investigation activities, used to record the execution time of archaeological investigative activities."@en,
        "发掘调查活动的时间跨度。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span> .

:FunctionalSpatialRelationType a owl:Class ;
    rdfs:label "functional spatial relation type"@en,
        "功能空间关系类型"@zh ;
    rdfs:comment "Base class for the \"functional spatial relation type\" concept. Corresponds to CIDOC CRM crm:E55_Type through mmho:Type indirect inheritance. Concrete functional spatial relation type enumeration values are to be added later as instances (rdf:type) of this class, after being abstracted from archaeological report corpora. The ontology does not pre-instantiate concrete types."@en,
        "类型概念——本体的\"功能空间关系类型\"基础类。通过 mmho:Type 间接继承 CIDOC CRM crm:E55_Type。具体的功能空间关系类型（如\"重力顺流型\"\"就近排放型\"等）由作者以后从考古报告语料中归纳后，作为本 Class 的实例（rdf:type）添加。本体不预设具体类型。"@zh ;
    rdfs:subClassOf :Type .

:Gold_Panning_and_Smelting a owl:Class ;
    rdfs:label "Gold_ Panning_and_ Smelting"@en,
        "黄金淘冶"@zh ;
    rdfs:subClassOf :SmeltingTechniques .

:Latitude a owl:Class ;
    rdfs:label "Latitude"@en,
        "纬度"@zh ;
    rdfs:subClassOf :GeographicCoordinates .

:Longitude a owl:Class ;
    rdfs:label "Longitude"@en,
        "经度"@zh ;
    rdfs:subClassOf :GeographicCoordinates .

:MaterialComponentNote a owl:Class ;
    rdfs:label "Material Component Note"@en,
        "材料成分说明"@zh ;
    rdfs:comment "Textual descriptions of material composition, used to describe the composition of metallic materials."@en,
        "材料成分说明文本，用于描述金属材料的成分信息。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E62_String> .

:Mercury_Smelting a owl:Class ;
    rdfs:label "Mercury_ Smelting"@en,
        "炼汞"@zh ;
    rdfs:subClassOf :SmeltingTechniques .

:NickelSilver a owl:Class ;
    rdfs:label "Nickel Silver"@en,
        "镍白铜"@zh ;
    rdfs:subClassOf :CopperAlloys .

:PeriodRelatedNotes a owl:Class ;
    rdfs:label "Period Related Notes"@en,
        "时期相关备注"@zh ;
    rdfs:comment "Notes related to a time period, used to record detailed explanations of the period."@en,
        "与时期相关的备注信息。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E62_String> .

:PrimaryReferenceNumber a owl:Class ;
    rdfs:label "Primary Reference Number"@en,
        "主参考编号"@zh ;
    rdfs:comment "Primary reference number uniquely identifying sites, anthropic features, or artifacts, supporting cross-database citation and tracking."@en,
        "主参考编号，用于唯一标识遗址、遗迹单元或遗物。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E42_Identifier> .

:SpecificYear a owl:Class ;
    rdfs:label "Specific Year"@en,
        "测年具体年代"@zh ;
    rdfs:comment "Specific year information obtained through dating methods, such as radiocarbon dating."@en,
        "测年得到的具体年代信息。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E62_String> .

:hasFunctionalSpatialRelation a owl:ObjectProperty ;
    rdfs:label "has functional spatial relation"@en,
        "具有功能空间关系"@zh ;
    rdfs:comment "Annotates workflow-driven functional spatial topology between anthropogenic features within a mining and metallurgy site. Examples: between mining shaft and smelting furnace (gravity-based ore flow); between smelting area and slag heap (close-proximity slag discharge). Differs from generic proximity-based spatial relations."@en,
        "标注矿冶遗址内部不同人工遗迹单元之间的功能空间拓扑关系——由冶金生产流程驱动的空间组织逻辑。以铜绿山古铜矿遗址为例，采矿区的坚井与冶炼区的炼炉之间存在\"矿石自高向低顺流而下\"的拓扑关系；冶炼区与排渣场之间存在\"废渣就近排放\"的关系。这种关系与一般\"邻近-距离\"的地理位置关系不同，强调生产流程对空间布局的决定作用。"@zh ;
    rdfs:domain :AnthropicFeature ;
    rdfs:range :AnthropicFeature .

:hasSuccessor a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "has successor"@en,
        "后件工序是"@zh ;
    rdfs:comment "Inverse of mmho:hasPredecessor. Annotates the successor relation in a same-period production workflow—the successor process takes the output of the predecessor as its input. See mmho:hasPredecessor for full design rationale (workflow chain vs cross-period evolution vs fallback)."@en,
        "标注两个生产技术之间同期工艺链的后件工序关系（mmho:hasPredecessor 的互逆属性）。后件工序接收前件工序的产物作为其输入。其他设计依据同 mmho:hasPredecessor：仅用于同期工艺链；跨时代演化请用 mmho:hasProcessEvolution；语义模糊时请用 mmho:hasAssociationWith 兜底。"@zh ;
    rdfs:domain :ProductionTechniques ;
    rdfs:range :ProductionTechniques .

