:ActivityType a owl:Class ;
    rdfs:label "ActivityType"@en,
        "活动类型"@zh ;
    rdfs:comment "Classification of investigative activities, such as archaeological excavation and archaeological survey."@en,
        "调查活动的类型分类，如考古发掘、考古调查等。"@zh ;
    rdfs:subClassOf :Type .

:AdministrativeAreaName a owl:Class ;
    rdfs:label "Administrative Area Name"@en,
        "行政区域名称"@zh ;
    rdfs:comment "Names of administrative regions where mining and metallurgy sites are located (e.g., provinces, cities, counties), used to identify the administrative affiliation of sites. Administrative area information supports site query and management by administrative divisions."@en,
        "行政区域名称，如省、市、县等。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E41_Appellation> .

:Casting_Defects a owl:Class ;
    rdfs:label "Casting Defects"@en,
        "铸造缺陷"@zh ;
    rdfs:comment "保存状态类型的子类: 铸造缺陷"@zh ;
    rdfs:subClassOf :ConditionType .

:DimensionInformation a owl:Class ;
    rdfs:label "Dimension Information"@en,
        "尺寸信息"@zh ;
    rdfs:comment "Dimension information of excavated artifacts or anthropic features, recording physical size measurements (length, width, height, weight, etc.) of artifacts, or depth, cross-section, etc. of anthropic features."@en,
        "出土遗物或人为遗迹单元的尺寸信息，记录遗物的长度、宽度、高度、重量等，或遗迹的深度、横截面等物理尺寸测量值。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E54_Dimension> .

:ExcavatedArtifactsType a owl:Class ;
    rdfs:label "Excavated Artifacts Type"@en,
        "出土遗物类型"@zh ;
    rdfs:comment "Type classification of excavated artifacts, used to categorize artifacts by type."@en,
        "出土遗物的类型分类。"@zh ;
    rdfs:subClassOf :Type .

:GeographicCoordinates a owl:Class ;
    rdfs:label "Geographic Coordinates"@en,
        "地理坐标"@zh ;
    rdfs:comment "Geographic coordinate information expressed in latitude and longitude, used to precisely locate a place."@en,
        "地理坐标信息，以经纬度表示。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E94_Space_Primitive> .

:Inscription a owl:Class ;
    rdfs:label "Inscription"@en,
        "铭文"@zh ;
    rdfs:subClassOf :VisualFeatureType .

:InvestigativeActivity a owl:Class ;
    rdfs:label "Investigative Activity"@en,
        "调查活动"@zh ;
    rdfs:comment "Various investigative activities conducted at mining and metallurgy sites, such as archaeological excavation and field survey. These activities are core data sources for mining and metallurgy archaeological research."@en,
        "针对矿冶遗址开展的各类调查活动，如考古发掘、田野调查等。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E7_Activity> .

:LateShang a :Period,
        owl:NamedIndividual ;
    rdfs:label "Late Shang"@en,
        "商晚期"@zh ;
    :hasBroaderPeriod :Shang ;
    rdfs:comment "约公元前 1300-前 1046 年，商代晚期，殷墟文化时期。"@zh .

:MiningTools a owl:Class ;
    rdfs:label "Mining Tools"@en,
        "采矿工具"@zh ;
    rdfs:subClassOf :ProductionTools .

:SmeltingTools a owl:Class ;
    rdfs:label "Smelting Tools"@en,
        "冶炼工具"@zh ;
    rdfs:subClassOf :ProductionTools .

:Steelmaking a owl:Class ;
    rdfs:label "Steelmaking"@en,
        "炼钢"@zh ;
    rdfs:subClassOf :SmeltingTechniques .

:Tang a :Period,
        owl:NamedIndividual ;
    rdfs:label "Tang Dynasty"@en,
        "唐代"@zh ;
    rdfs:comment "公元 618-907 年，中国历史上继汉代之后又一个盛世王朝。"@zh .

:AnimalMotifPattern a owl:Class ;
    rdfs:label "Animal Motif Pattern"@en,
        "现实动物纹饰"@zh ;
    rdfs:subClassOf :Pattern .

:Bronze a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Bronze"@en,
        "青铜"@zh ;
    rdfs:subClassOf :CopperAlloys .

:Casting a owl:Class ;
    rdfs:label "Casting"@en,
        "铸造"@zh ;
    rdfs:subClassOf :FormingTechniques .

:ConditionType a owl:Class ;
    rdfs:label "Condition Type"@en,
        "保存状态类型"@zh ;
    rdfs:comment "Type classification of preservation conditions, used to categorize artifact preservation states."@en,
        "保存状态的类型分类。"@zh ;
    rdfs:subClassOf :Type .

:ConservationLevel a owl:Class ;
    rdfs:label "Conservation Level"@en,
        "文物保护级别"@zh ;
    rdfs:comment "Conservation level of cultural heritage sites under the Chinese cultural heritage protection system. Instances are conservation level tags such as national-level, provincial-level, municipal-level, and county-level."@en,
        "文物保护级别，作为类型标签实例化。按中国文物保护制度分为全国重点、省级、市级、县级四级。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> .

:MythologicalCreaturePattern a owl:Class ;
    rdfs:label "Mythological Creature Pattern"@en,
        "神话生物纹饰"@zh ;
    rdfs:subClassOf :Pattern .

:OreAndSmeltingMaterials a owl:Class ;
    rdfs:label "Ore and Smelting Materials"@en,
        "矿冶原料"@zh ;
    rdfs:comment "Raw materials used in mining and metallurgy activities, including natural ores, preliminarily smelted metal ingots, fluxes, and fuels. These raw materials are the fundamental material conditions of mining and metallurgy production. Examples: ores, recycled materials, fluxes, fuels."@en,
        "矿冶生产所需的原料，包括矿石、燃料、助熔剂等。"@zh ;
    rdfs:subClassOf :ExcavatedArtifactsType,
        <http://www.cidoc-crm.org/cidoc-crm/E19_Physical_Object> .

:ProductionTools a owl:Class ;
    rdfs:label "Production Tools"@en,
        "生产工具"@zh ;
    rdfs:comment "Production tools used in mining and metallurgy activities, including mining tools, smelting tools, casting tools, and processing tools. These tools reflect the technological level of mining and metallurgy at the time. Examples: stone hammers, crucibles, smelting furnaces, moulds."@en,
        "矿冶生产过程中使用的各类工具，如采矿工具、冶炼工具等。"@zh ;
    rdfs:subClassOf :ExcavatedArtifactsType,
        <http://www.cidoc-crm.org/cidoc-crm/E22_Man-Made_Object> .

:SmeltingProducts a owl:Class ;
    rdfs:label "Smelting Products"@en,
        "冶炼产品"@zh ;
    rdfs:comment "Products of mining and metallurgy activities, including intermediate products (such as clay moulds and clay cores), final products (such as bronze artifacts and iron artifacts), and waste (such as slag and sprues). Smelting products are the core objects of mining and metallurgy archaeological research. Examples: ingots, bronze tripods, slag."@en,
        "冶炼活动产生的各类产品，如金属锭、炉渣、金属器等。"@zh ;
    rdfs:subClassOf :ExcavatedArtifactsType,
        <http://www.cidoc-crm.org/cidoc-crm/E22_Man-Made_Object> .

<http://www.cidoc-crm.org/cidoc-crm/P2_has_type> a owl:ObjectProperty ;
    rdfs:label "P2 has type"@en,
        "P2 有类型"@zh .

:GeometricPattern a owl:Class ;
    rdfs:label "Geometric Pattern"@en,
        "几何纹饰"@zh ;
    rdfs:subClassOf :Pattern .

:ProcessingTechniques a owl:Class ;
    rdfs:label "Processing Techniques"@en,
        "加工技术"@zh ;
    rdfs:subClassOf :ProductionTechniques .

:SmeltingTechniques a owl:Class ;
    rdfs:label "Smelting Techniques"@en,
        "冶炼技术"@zh ;
    rdfs:subClassOf :ProductionTechniques .

:MiningAndMetallurgySite a owl:Class ;
    rdfs:label "Mining and Metallurgy Site"@en,
        "矿冶遗址"@zh ;
    rdfs:comment "Sites primarily engaged in mining, smelting, casting, and other metallurgical activities, preserving the material remains of human exploitation and utilization of mineral resources at specific locations. These sites may contain multiple anthropic features, including mining pits, mining shafts, smelting areas, and casting areas. Inherits from CIDOC CRM E27 Site. Examples: Tonglushan Ancient Copper Mine Site, Yinxu Miaopu Beidi Bronze Casting Site, Luoyang Beiyao Western Zhou Bronze Casting Site."@en,
        "以采矿、冶炼、铸造等矿冶活动为主的遗址。继承自CIDOC CRM E27 Site。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E27_Site> .

:Type a owl:Class ;
    rdfs:label "Type"@en,
        "类型"@zh ;
    rdfs:comment "Base class for classification concepts, used for various classification systems, corresponding to CIDOC CRM E55_Type."@en,
        "类型概念的基础类，用于各类分类体系，对应CIDOC CRM E55_Type。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E55_Type> .

:ExcavatedArtifacts a owl:Class ;
    rdfs:label "Excavated Artifacts"@en,
        "出土遗物"@zh ;
    rdfs:comment "Excavated artifacts from archaeological excavation, including production tools, smelting products, and mining materials. These artifacts are direct physical evidence for mining and metallurgy research. Inherits from CIDOC CRM E18 Physical Thing."@en,
        "考古发掘出土的各类遗物，包括生产工具、冶炼产品和矿冶原料。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing> .

:DimensionType a owl:Class ;
    rdfs:label "Dimension Type"@en,
        "测量尺寸类型"@zh ;
    rdfs:comment "Type classification of measured dimensions, such as length, width, and thickness."@en,
        "测量尺寸的类型分类，如长度、宽度、厚度等。"@zh ;
    rdfs:subClassOf :Type .

:MetallicMaterials a owl:Class ;
    rdfs:label "Metallic Materials"@en,
        "金属材料"@zh ;
    rdfs:comment "Various metallic materials, such as copper, iron, lead, tin, gold, and silver. These materials are the basis of mining and metallurgy products."@en,
        "各类金属材料，如铜、铁、铅、锡、金、银等。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E57_Material> .

:ProductionTechniques a owl:Class ;
    rdfs:label "Production Techniques"@en,
        "生产技术"@zh ;
    rdfs:comment "Various technical methods adopted in the mining and metallurgy production process, including mining, smelting, casting, and processing techniques."@en,
        "矿冶生产过程中采用的各类技术方法。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure> .

:AnthropicFeature a owl:Class ;
    rdfs:label "Anthropic Feature"@en,
        "人为遗迹单元"@zh ;
    rdfs:comment "Anthropic features intentionally created by human activities within mining and metallurgy sites, such as mining pits and shafts formed by mining activities, smelting areas formed by smelting activities, and casting areas formed by casting activities. These features are components of mining and metallurgy sites, reflecting specific mining and metallurgy production activities. Inherits from CIDOC CRM E25 Human-Made Feature. Examples: mining pits (open-pit mining pits), mining shafts (underground mining shafts), smelting areas (blocks containing furnaces and bellows pipes), casting areas (blocks containing moulds and crucibles), ash pits (waste-dumping pits)."@en,
        "矿冶遗址内人类活动有意创建的各种遗迹单元。继承自CIDOC CRM E25 Human-Made Feature。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E25_Human-Made_Feature> .

:Province a owl:Class ;
    rdfs:label "Province"@en,
        "省"@zh ;
    rdfs:subClassOf :AdministrativeAreaName .

:Period a owl:Class ;
    rdfs:label "Period"@en,
        "时代"@zh ;
    rdfs:comment "Archaeological cultural periodization, mapped to CIDOC CRM E41 Appellation to facilitate the use of typological features. Examples: Shang Dynasty, Western Zhou, Han Dynasty."@en,
        "考古学文化分期，映射为E41 Appellation以兼容类型化特征。"@zh ;
    rdfs:subClassOf <http://www.cidoc-crm.org/cidoc-crm/E41_Appellation> .

:FinalProducts a owl:Class ;
    rdfs:label "Final Products"@en,
        "最终产品"@zh ;
    rdfs:subClassOf :SmeltingProducts .

[] a owl:AllDisjointClasses ;
    owl:members ( :Brass :Bronze :NickelSilver ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :CopperSmelting :Cupellation :Gold_Panning_and_Smelting :IronSmelting :Mercury_Smelting :Steelmaking ) .

[] a owl:AllDisjointClasses ;
    owl:members ( :Altitude :Latitude :Longitude ) .

